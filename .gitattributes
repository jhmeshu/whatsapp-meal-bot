# Normalise line endings on checkout.

# Source files: LF everywhere.
* text=auto eol=lf

# Windows batch scripts MUST be CRLF. LF-only .bat files intermittently break
# `goto` label resolution and `for` loop parsing in cmd.exe.
*.bat text eol=crlf
*.cmd text eol=crlf

# Never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.mp4 binary
*.exe binary