# Copy this file to `.env` and adjust. `.env` is gitignored - never commit real values.

# ---------------------------------------------------------------------------
# Chrome
# ---------------------------------------------------------------------------

# Full path to your Google Chrome executable.
# Leave blank to auto-detect. Auto-detection checks, in order:
#   Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
#            C:\Program Files (x86)\Google\Chrome\Application\chrome.exe
#            %LOCALAPPDATA%\Google\Chrome\Application\chrome.exe
#   macOS:   /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
#   Linux:   /usr/bin/google-chrome-stable
#
# The bot NEEDS real Chrome. The Chromium bundled with Puppeteer lacks the
# H.264/AAC codecs and breaks WhatsApp Web.
CHROME_PATH=

# ---------------------------------------------------------------------------
# Session
# ---------------------------------------------------------------------------

# Name shown for this session under WhatsApp > Settings > Linked devices.
# Use something obvious so it can be recognised and revoked later.
DEVICE_NAME=Meal Bot

# Browser name reported to WhatsApp. Valid: Chrome | Firefox | IE | Opera | Safari | Edge
BROWSER_NAME=Chrome

# Directory holding the persisted session. Must survive restarts, otherwise you
# will be prompted to scan a QR code every time the bot starts.
DATA_PATH=.wwebjs_auth

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------

# Leave false on a desktop machine so the Chrome window is visible. This makes
# debugging a failed login dramatically easier.
HEADLESS=false
